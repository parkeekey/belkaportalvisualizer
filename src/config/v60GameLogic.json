  "uiHelpers": {
    "formatClock": "mm:ss",
    "parseMmSsRegex": "^(\\d{1,2}):(\\d{1,2})$",
    "parseMmSsClamp": {
      "minSec": 60,
      "maxSec": 420,
      "maxSecondsPart": 59
    },
    "pourPatterns": {
