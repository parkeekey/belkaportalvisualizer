  "functions": {
    "computeKValue": {
      "baseByRoast": {
        "light": 80,
        "medium": 50,
        "dark": 25
      },
      "modByProcess": {
        "washed": 5,
        "honey": 0,
        "natural": -5,
        "anaerobic": -10
      },
      "expression": "clamp(10, 100, base + mod)"
    },
    "waterViscosityPaS": {
      "expression": "2.414e-5 * 10^(247.8 / ((clamp(1,100,tempC)+273.15) - 140))"
    },
    "solubilityFactor": {
      "expression": "clamp(0.7, 1.15, 0.72 + (tempC - 75) * 0.017)"
    }
  },
  "model": {
    "geometry": {
      "viewScale": "topRimVisual / spec.top",
      "v60Height": "spec.height * viewScale",
      "v60TopY": 5,
      "v60BottomY": "v60TopY + v60Height",
      "v60Slope": "(30 - (spec.bottom * viewScale)/2) / v60Height",
      "bedTopY": "v60TopY + v60Height * (1 - min(0.85, dose * 0.02))",
      "bedBottomY": "v60BottomY"
    },
    "darcyFilter": {
      "eps": "clamp(0.32, 0.52, 0.48 - (finesPct/100)*0.12 - (1-bedIntegrity)*0.06)",
      "alphaBase": "clamp(0.15, 0.25, (ribCount * ribWidth * slant) / areaTotal)",
      "alpha": "clamp(0.15, 0.28, alphaBase + min(0.05, inDripper/max(10,waterVol)*0.08))",
      "rFilter0": "paperThickness / (kPaperBase * paperMeta.permScale)",
      "rFilter": "rFilter0 * (1 + paperMeta.finesLoad * throughputKg) * (1 + filterCakeLoad * 1.8)",
      "rFilterEffective": "rFilter / (1 - alpha)",
      "bedVolume": "(dose / 1000) / bulkDensity",
      "lBed": "clamp(0.005, 0.04, bedVolume / aTop)",
      "hHead": "clamp(0, 0.09, (inDripper/1000000) / aTop)",
      "kKozeny": "(180 * (1-eps)^2) / (phiS^2 * Dp^2 * eps^3)",
      "rBed": "kKozeny * lBed",
      "deltaP": "rho * gravity * hHead",
      "q": "deltaP * aTop / (mu * (rBed + rFilterEffective))",
      "baseDrainRate": "clamp(0.03, 7, q * rho * 1000 * dripperMeta.drainGain)"
    },
    "groundCompaction": {
      "groundCompaction": "clamp(0,1, filterCakeLoad*0.55 + bedMoisture*0.25 + (finesPct/100)*0.22 + max(0,0.9-baseDrainRate)*0.18)",
      "pointBreakdown": {
        "cakePts": "clamp(0,35, round(filterCakeLoad*35))",
        "moisturePts": "clamp(0,25, round(bedMoisture*25))",
        "finesPts": "clamp(0,20, round((finesPct/100)*20))",
        "slowFlowPts": "clamp(0,20, round((max(0,0.9-baseDrainRate)/0.9)*20))"
      },
      "groundPoints": "clamp(0,100, cakePts + moisturePts + finesPts + slowFlowPts)",
      "groundStatus": "Loose if <0.33, Muddy if <0.7, else Stuck",
      "drawdownForceFactor": "clamp(0.45, 1.08, 1.05 - groundCompaction*0.55)",
      "extractionRateFactor": "0.9 if Loose, 1.0 if Muddy, 1.12 if Stuck",
      "tdsConcentrationFactor": "0.78 if Loose, 1.0 if Muddy, 1.12 if Stuck"
    },
    "bloomAndDegas": {
      "retainedWaterEq": "bedMoisture * dose * 0.18",
      "saturationDepth": "clamp(0,1, (inDripper + retainedWaterEq) / max(1,dose*1.05))",
      "bloomTimeSec": 40,
      "bloomWaterTarget": "dose * 2.8",
      "bloomProgress": "if poured<=0 then 0 else min(1, max(elapsed/bloomTimeSec, poured/max(1,bloomWaterTarget)))",
      "inBloom": "poured > 0 and bloomProgress < 1",
      "degasLevel": "clamp(8,95, round(98 * exp(-coffeeAgeDays/24)))",
      "degasFactor": "clamp(0,1,degasLevel/100)",
      "degasAbsorbCapacity": "dose * (1.6 + 1.6*degasFactor)",
      "absorbProgress": "min(1, poured / max(1, degasAbsorbCapacity))",
      "absorbShield": "if inBloom then degasFactor*(1-absorbProgress) else degasFactor*0.15*max(0,1-inDripper/max(1,dose*0.6))"
    },
    "channelRisk": {
      "heightNorm": "clamp(0,1,(pourHeightCm-1)/19)",
      "dryHitRatio": "clamp(0,1,(dose*0.25-inDripper)/max(1,dose*0.25))",
      "dryImpactBoost": "if isPouring then 1 + dryHitRatio*0.95 else 1",
      "headTerm": "min(0.32, (max(0, inDripper/max(1,dose*1.8))^1.15) * 0.22)",
      "drainTerm": "min(0.28, max(0,0.55-baseDrainRate)*0.55)",
      "integrityTerm": "(1-bedIntegrity)*0.16",
      "finesTerm": "(finesPct/100)*0.1",
      "turbulenceTerm": "if isPouring then max(0,(pourRate-4.5)/11) * (0.08 + 0.45*heightNorm) * dryImpactBoost else 0",
      "memoryTerm": "min(0.26, channelMemory*0.24)",
      "channelRawBase": "headTerm + drainTerm + integrityTerm + finesTerm + turbulenceTerm + memoryTerm",
      "channelRaw": "channelRawBase * (1 - absorbShield*0.85)",
      "bloomSuppression": "if inBloom then (0.08 + bloomProgress*0.5) else 1",
      "lowHeadRelief": "if !inBloom and inDripper < dose*0.15 then 0.55 else 1",
      "channelRisk": "if inDripper<=0 then 0 else min(1, if inBloom then min(0.18, channelRaw*bloomSuppression) else min(0.65, channelRaw*lowHeadRelief))",
      "bypassFlow": "channelRisk * 0.4"
    },
    "flowAndDrain": {
      "drainRate": "(baseDrainRate + bypassFlow) * drawdownForceFactor",
      "resistanceVal": "clamp(0.2, 10, (rBed + rFilterEffective) / 1e9)",
      "extractionEfficiency": "clamp(0.2, 1, 1 - channelRisk*0.65)",
      "waterHead": "max(0.2, inDripper / max(1,dose))",
      "effectiveDrainRate": "drainRate * waterHead",
      "drainProgress": "if poured > 0 then clamp(0,1,drained/max(1,poured)) else 0"
    },
    "visualWater": {
      "topWaterOpacity": "if inDripper>0.05 then clamp(0,0.58,(inDripper/max(1,dose*1.45))*0.58) * (1 - drainProgress*0.82) else 0",
      "topPoolScale": "clamp(0,1,inDripper/max(1,dose*1.25))",
      "visualSaturationDepth": "clamp(0,1,inDripper/max(1,dose*0.95))",
      "sideWaterOpacity": "if inDripper>0.05 then clamp(0,0.62,(inDripper/max(1,dose*1.6))*0.7) * (1 - drainProgress*0.9) else 0"
    },
    "pourDynamics": {
      "targetPour": "max(0.2, maxPourRate + pourFlowTrim)",
      "responseSec": "if targetPour <= 6 then 0.8 else max(1.5, dripperMeta.pourRampSec * (targetPour/10))",
      "pourAlpha": "1 - exp(-timeStep / max(0.05, responseSec/3))",
      "pourRateNext": "pourRate + (targetPour - pourRate) * pourAlpha",
      "addedWater": "pourRate * timeStep",
      "decayAlphaWhenNotPouring": "1 - exp(-timeStep / 0.15)"
    },
    "diffusionImmersion": {
      "avgWaterContactAgeUpdate": "if curInDripAfterDrain>0.02 then ((max(0,curInDripAfterDrain-addedFreshThisTick) * (prevAge + timeStep)) / max(1e-6,curInDripAfterDrain)) else 0",
      "freshness": "exp(-avgWaterContactAge/45)",
      "freshWaterFactor": "0.55 + 0.45*freshness",
      "diffusionFactor": "0.8 + 0.25*freshness + (isPouring ? 0.05 : 0)",
      "immersionDecay": "1 - min(0.45, avgWaterContactAge/150)",
      "waterEffectiveness": "clamp(0.45, 1.2, freshWaterFactor * diffusionFactor * immersionDecay)"
    },
    "extractionTds": {
      "roastFactor": {
        "dark": 1.4,
        "medium": 1.0,
        "light": 0.7
      },
      "timeConst": "30 / drainRate / max(0.5,surfaceArea/30000) / roastFactor / tempSolubility / max(0.55,extractionRateFactor) / max(0.3,waterEffectiveness)",
      "extracted": "dose * 0.30 * (1 - exp(-elapsed/timeConst)) * extractionEfficiency * tempSolubility * clamp(0.35,1.08,waterEffectiveness)",
      "waterMass": "if drained>0.1 then drained else max(0.1,poured)",
      "fastDrainDilution": "max(0,effectiveDrainRate-1.6) * 0.11",
      "bypassDilution": "channelRisk * 0.18",
      "lowContactDilution": "max(0,1-avgWaterContactAge/35) * 0.14",
      "cupDilutionFactor": "clamp(0.58,1, 1 - fastDrainDilution - bypassDilution - lowContactDilution)",
      "tdsRaw": "(extracted/waterMass)*100 * tdsConcentrationFactor * cupDilutionFactor",
      "tdsClamp": {
        "min": 0.72,
        "max": 3.2
      },
      "tds": "clamp(0.72,3.2,tdsRaw)",
      "ey": "(extracted/dose)*100"
    },
    "ecModel": {
      "washIndex": "min(1, drained/max(1,poured))",
      "saturationIndex": "min(1, curInDrip/max(1,dose*1.1))",
      "agitation": {
        "increaseWhenPouring": "min(1, agitation + timeStep*2)",
        "decreaseWhenIdle": "max(0, agitation - timeStep*0.8)"
      },
      "eyProgress": "min(1, extracted/(dose*0.30))",
      "bloomPeakBase": "16.8 + bloomProgress*3.6 + degasFactor*1.2 + (finesPct/100)*0.8 + max(0,tempSolubility-1)*1.8",
      "bloomPeak": "min(21.2, bloomPeakBase + agitation*0.6)",
      "postBase": "11.5 + (1-washIndex)*5.2 + eyProgress*2.4*max(0.7,waterEffectiveness)",
      "washDrive": "(isPouring ? 1 : 0.05) * (0.7 + saturationIndex*0.9)",
      "washDrop": "washIndex * 7.8 * washDrive",
      "targetSlurry": "if inBloom then bloomPeak else clamp(4.0,22,postBase-washDrop)",
      "slurryResponse": "if inBloom then 3.4 else (isPouring ? 1.8 : 0.08)",
      "slurryAlpha": "1 - exp(-timeStep * slurryResponse)",
      "ecSlurry": "ecSlurry + (targetSlurry - ecSlurry) * slurryAlpha",
      "transfer": "clamp(0.35,0.85,0.52 + saturationIndex*0.25 - channelRisk*0.18)",
      "targetOut": "max(1.5, ecSlurry*transfer - washIndex*(isPouring ? 3.0 : 0.5))",
      "outResponse": "isPouring ? 2.4 : 0.1",
      "outAlpha": "1 - exp(-timeStep * outResponse)",
      "ecOutTrue": "ecOutTrue + (targetOut - ecOutTrue) * outAlpha",
      "sensorAlpha": "1 - exp(-timeStep / max(0.08, ecCalibration.lagSec))",
      "sensorNoise": "ecCalibration.noiseAmp * (0.6*sin(elapsed*2.3) + 0.4*sin(elapsed*5.1))",
      "ecOut": "clamp(0,23, ecOutSensor + sensorNoise)",
      "ecSlurryClamped": "clamp(0,23, ecSlurry)",
      "ecToTds": "clamp(0,4, ecOut * ecCalibration.tdsFactor)",
      "drainDelta": "max(0, effectiveDrainRate * timeStep)",
      "ecExtractDelta": "drainDelta * (ecToTds / 100)",
      "ecEyEstimate": "(ecExtracted / max(0.1,dose))*100",
      "sampleCadenceSec": 0.5
    },
    "bedDynamics": {
      "integrityMin": 0.35,
      "decayPerSec": "(0.003 + contactIntensity*0.012 + aggression*0.02 + channelRisk*0.01) * bloomDecayScale * degasDecayShield",
      "recoverPerSec": "if curInDrip<0.2 then (inBloom ? 0.003 : 0.002) else 0",
      "bedIntegrity": "clamp(0.35,1, bedIntegrity - decayPerSec*timeStep + recoverPerSec*timeStep)",
      "cakeBuild": "(finesPct/100) * (0.006 + contactIntensity*0.006 + aggression*0.02) * timeStep",
      "cakeFlush": "if !isPouring and effectiveDrainRate>1.2 then (effectiveDrainRate-1.2)*0.0012*timeStep else 0",
      "filterCakeLoad": "clamp(0,1.3, filterCakeLoad + cakeBuild - cakeFlush)",
      "memoryDecay": "(!isPouring ? 0.012 : 0.004) * (1 - aggression*0.5) * timeStep",
      "channelMemory": "clamp(0,1, channelMemory - max(0,memoryDecay))",
      "bedMoistureTarget": "min(1, (curInDrip + dose*0.06) / (dose*0.5))",
      "bedMoistureSmoothing": "if curInDrip>0.5 then 0.06 else 0.004",
      "bedMoisture": "clamp(0.04,1, bedMoisture + (target-bedMoisture)*smoothing*timeStep*30)"
    }
  },
  "planner": {
    "eyTargetCenter": "clamp(17.5,21.5, 19.2 + (ratio-16)*0.18)",
    "eySuggestedLow": "max(16.8, eyTargetCenter - 1.1)",
    "eySuggestedHigh": "min(22.5, eyTargetCenter + 1.1)",
    "tdsTargetCenter": "clamp(1.05,1.7, 1.42 - (ratio-16)*0.08)",
    "tdsSuggestedLow": "max(0.95, tdsTargetCenter - 0.16)",
    "tdsSuggestedHigh": "min(1.95, tdsTargetCenter + 0.16)",
    "targetPourRateNow": "max(0.2, maxPourRate + pourFlowTrim)",
    "remainingToPour": "max(0, waterVol - poured)",
    "projectedDrainRate": "max(0.25, effectiveDrainRate)",
    "projectedPourSec": "remainingToPour / targetPourRateNow",
    "projectedHeldWater": "inDripper + remainingToPour * 0.55",
    "projectedDrawdownSec": "projectedHeldWater / projectedDrainRate",
    "expectedFinishSec": "elapsed + projectedPourSec + projectedDrawdownSec",
    "observedCupRate": "if drained>20 and elapsed>10 then drained/elapsed else waterVol/max(1,expectedFinishSec)",
    "recommendedRatioForTime": "clamp(5,25, (observedCupRate * max(60,targetFinishSec)) / max(0.1,dose))"
  },
  "statusAndThresholds": {
    "ageBand": [
